# Copy to .env.local for development. Leave the Supabase values empty to run on built-in demo data.
# These are public values: they end up in the browser bundle.

# Supabase: Project Settings -> API Keys
VITE_SUPABASE_URL=https://agxxlkxsmqzqrnrribuq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# The Git server (clone URLs and the code-browsing API)
VITE_GIT_SERVER_URL=

# Path the site is served from. GitHub Pages project sites use /<repo>/; a custom domain uses /.
# VITE_BASE_PATH=/GitAi/

# Demo mode only: pretend to be signed in as this sample user (e.g. nova).
# VITE_DEMO_VIEWER=nova
