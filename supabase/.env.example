# OAuth credentials for Supabase Auth providers (referenced by supabase/config.toml).
# Copy to supabase/.env (git-ignored) and fill in. Never commit real values.
#
# Callback / redirect URL to register with every provider:
#   https://llvjlnksmradenkwsulp.supabase.co/auth/v1/callback

# GitHub: github.com/settings/developers -> OAuth Apps -> New OAuth App
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Microsoft: entra.microsoft.com -> App registrations -> New registration
#   (accounts in any organizational directory and personal Microsoft accounts)
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=

# Apple: developer.apple.com -> Identifiers -> Services ID (client id) + a Sign in with Apple key.
# The secret is a JWT generated from that key; it expires after 6 months.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
